# Gold Price API Configuration
# Get your free API key from https://www.goldapi.io/ (free tier: 100 requests/month)
VITE_GOLD_API_KEY=your_gold_api_key_here

# Alternative: Use https://metals-api.com/ (free tier: 100 requests/month)
# VITE_METALS_API_KEY=your_metals_api_key_here

# Exchange Rate API (optional, for VND conversion)
# Get free API key from https://app.exchangerate-api.com/ (1500 requests/month free)
VITE_EXCHANGE_API_KEY=your_exchange_api_key_here

# Set to 'true' to use mock data instead of real APIs (useful for development)
VITE_USE_MOCK_DATA=false
